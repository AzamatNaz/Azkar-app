/* ===== Ҳисобкунаки такрор ===== */
const counts = {};
function tapCount(key, target, btnId, numId, cardId){
  counts[key] = (counts[key]||0) + 1;
  if (counts[key] > target) counts[key] = 0;
  document.getElementById(numId).textContent = counts[key];
  const card = document.getElementById(cardId);
  if (counts[key] >= target){
    card.classList.add('done');
    if (tg) tg.HapticFeedback && tg.HapticFeedback.notificationOccurred('success');
  } else {
    card.classList.remove('done');
    if (tg) tg.HapticFeedback && tg.HapticFeedback.impactOccurred('medium');
  }
}

function zikrCardsHTML(list, keyPrefix){
  return list.map((it,i)=>{
    const key = keyPrefix+'-'+i;
    const cardId = 'card-'+key, numId='num-'+key;
    const counter = it.count ? `
      <div class="count-row">
        <div class="count-label">${it.n||''}</div>
        <button class="count-btn" onclick="tapCount('${key}',${it.count},'','${numId}','${cardId}')">
          Хондам <span class="count-num" id="${numId}">0</span>/${it.count}
        </button>
      </div>` : '';
    return `
    <div class="zikr-card" id="${cardId}">
      <div class="zikr-index">№ ${i+1}</div>
      <div class="zikr-arabic">${it.ar}</div>
      <div class="zikr-tj">${it.tj}</div>
      ${it.src ? `<div class="zikr-src">${it.src}</div>` : ''}
      ${counter}
    </div>`;
  }).join('');
}

function openChapter(id){
  const ch = CHAPTERS.find(c=>c.id===id);
  const idx = CHAPTERS.indexOf(ch);
  document.getElementById('detailTitle').textContent = 'Боби '+(idx+1);
  document.getElementById('detailSub').textContent = ch.name;
  const body = document.getElementById('detailBody');
  body.innerHTML = '';

  if (ch.type==='article'){
    body.innerHTML = `<div class="article">${ARTICLE_1}</div>`;
  } else if (ch.type==='zikr-subh'){
    body.innerHTML = `<div class="zikr-list">${zikrCardsHTML(SUBH,'subh')}</div>`;
  } else if (ch.type==='zikr-shom'){
    body.innerHTML = `<div class="zikr-list">${zikrCardsHTML(SHOM,'shom')}</div>`;
  } else if (ch.type==='ruqya'){
    body.innerHTML = `<div class="article">${CH8_INTRO}</div><div class="zikr-list">${zikrCardsHTML(CH8,'ruqya')}</div>`;
  } else {
    const data = {2:CH2,3:CH3,4:CH4,5:CH5,6:CH6}[id];
    body.innerHTML = `<div class="zikr-list">${zikrCardsHTML(data,'ch'+id)}</div>`;
  }
  document.getElementById('detailView').classList.add('open');
  if (tg) tg.HapticFeedback && tg.HapticFeedback.impactOccurred('light');
}
function closeDetail(){ document.getElementById('detailView').classList.remove('open'); }

/* ===== Вақти намоз (Aladhan API) ===== */
const PRAYER_LABELS = [
  {key:"Fajr", name:"Бомдод"}, {key:"Dhuhr", name:"Пешин"}, {key:"Asr", name:"Аср"},
  {key:"Maghrib", name:"Шом"}, {key:"Isha", name:"Хуфтан"}
];
async function loadPrayerTimes(city){
  const status = document.getElementById('prayerStatus');
  status.textContent = "Дар ҳоли боргирӣ...";
  try{
    const url = `https://api.aladhan.com/v1/timingsByCity?city=${encodeURIComponent(city)}&country=Tajikistan&method=2`;
    const res = await fetch(url);
    const data = await res.json();
    const t = data.data.timings;
    const grid = document.getElementById('prayerGrid');
    grid.innerHTML = '';
    const now = new Date();
    const nowMin = now.getHours()*60 + now.getMinutes();
    let nextIdx = -1, minDiff = 1e9;
    PRAYER_LABELS.forEach((p,i)=>{
      const [hh,mm] = t[p.key].slice(0,5).split(':').map(Number);
      let diff = (hh*60+mm) - nowMin;
      if (diff < 0) diff += 1440;
      if (diff < minDiff){ minDiff = diff; nextIdx = i; }
    });
    PRAYER_LABELS.forEach((p,i)=>{
      const div = document.createElement('div');
      div.className = 'prayer-item' + (i===nextIdx ? ' active' : '');
      div.innerHTML = `<div class="prayer-name">${p.name}</div><div class="prayer-time">${t[p.key].slice(0,5)}</div>`;
      grid.appendChild(div);
    });
    const hrs = Math.floor(minDiff/60), mins = minDiff%60;
    status.textContent = `То намози «${PRAYER_LABELS[nextIdx].name}» — ${hrs} соату ${mins} дақиқа монд`;
  } catch(e){
    status.textContent = "Хатои пайвастшавӣ ба интернет.";
  }
}
const citySelect = document.getElementById('citySelect');
citySelect.addEventListener('change', ()=> loadPrayerTimes(citySelect.value));
loadPrayerTimes(citySelect.value);
</script>
