<!DOCTYPE html>
<html lang="tg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Дуоҳои Ҳаррӯза</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@500;600;700&family=Noto+Naskh+Arabic:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0E2B26; --ink-2:#143B34; --ink-3:#1B4A40;
  --paper:#F6EFDD; --gold:#C9A24B; --gold-soft:#E7CE8C;
  --sage:#6FA98D; --ink-text:#20281F; --cream:#F4EFE0; --muted:#9FB8AE;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;}
body{
  background:radial-gradient(circle at 15% -10%,#1c5148 0%,transparent 45%),
             radial-gradient(circle at 110% 10%,#0a201c 0%,transparent 40%),var(--ink);
  color:var(--cream); font-family:'Inter',sans-serif; min-height:100vh; padding-bottom:20px;
}
.app{max-width:520px;margin:0 auto;}
header.top{padding:26px 20px 16px;}
.eyebrow{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-soft);font-weight:600;opacity:.85;}
h1.brand{font-family:'Noto Serif',serif;font-weight:700;font-size:26px;margin:6px 0 2px;}
.brand-sub{color:var(--muted);font-size:13px;line-height:1.5;}
.section-label{padding:0 20px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;margin:20px 0 10px;}
.cards{padding:0 16px;display:grid;gap:11px;}
.cat-card{background:var(--paper);color:var(--ink-text);border-radius:16px;padding:15px 16px;display:flex;align-items:center;gap:13px;cursor:pointer;}
.cat-card:active{transform:scale(.98);}
.cat-icon{width:44px;height:44px;border-radius:12px;background:#FDEFD9;display:flex;align-items:center;justify-content:center;font-size:21px;flex-shrink:0;}
.cat-num{font-family:'Noto Serif',serif;font-weight:700;font-size:12px;color:var(--gold);letter-spacing:.05em;}
.cat-name{font-family:'Noto Serif',serif;font-weight:600;font-size:15.5px;margin-top:1px;}
.cat-arrow{margin-left:auto;color:#b8ad93;font-size:18px;}

.detail{position:fixed;inset:0;background:var(--ink);transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);overflow-y:auto;z-index:20;padding-bottom:40px;}
.detail.open{transform:translateX(0);}
.detail-head{padding:16px;display:flex;align-items:center;gap:12px;position:sticky;top:0;background:var(--ink);z-index:5;border-bottom:1px solid rgba(244,239,224,.08);}
.back-btn{width:36px;height:36px;border-radius:11px;background:rgba(244,239,224,.08);display:flex;align-items:center;justify-content:center;font-size:17px;border:none;color:var(--cream);flex-shrink:0;}
.detail-title{font-family:'Noto Serif',serif;font-size:17px;font-weight:700;}
.detail-sub{font-size:11.5px;color:var(--muted);margin-top:1px;}

.article{padding:16px 18px;font-size:14.5px;line-height:1.75;color:var(--cream);}
.article p{margin:0 0 14px;}
.article .pt{font-weight:700;color:var(--gold-soft);}

.zikr-list{padding:14px 16px;}
.zikr-card{background:var(--paper);color:var(--ink-text);border-radius:16px;padding:16px;margin-bottom:12px;}
.zikr-index{font-size:11px;font-weight:700;color:var(--gold);letter-spacing:.05em;margin-bottom:9px;}
.zikr-arabic{font-family:'Noto Naskh Arabic',serif;direction:rtl;font-size:21px;line-height:2;margin-bottom:9px;color:#241f14;}
.zikr-tj{font-size:14px;line-height:1.55;color:#2d2718;}
.zikr-src{margin-top:11px;padding-top:10px;border-top:1px dashed #ddd0aa;font-size:11.5px;color:#8a7f5f;}
.zikr-n{display:inline-block;margin-top:8px;background:var(--ink);color:var(--gold-soft);font-size:11.5px;font-weight:700;padding:4px 10px;border-radius:8px;}
.hidden{display:none !important;}

.count-row{margin-top:12px;display:flex;align-items:center;justify-content:space-between;border-top:1px dashed #ddd0aa;padding-top:12px;}
.count-label{font-size:12px;color:#8a7f5f;font-weight:600;}
.count-btn{display:flex;align-items:center;gap:9px;background:var(--ink);color:var(--cream);border:none;border-radius:12px;padding:8px 14px;font-family:'Inter',sans-serif;font-weight:600;font-size:13px;}
.count-num{background:var(--gold);color:#231a08;min-width:24px;height:24px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;}
.zikr-card.done{box-shadow:inset 0 0 0 2px var(--sage);}

.prayer-card{margin:14px 16px 4px;background:linear-gradient(155deg,var(--ink-3),var(--ink-2));border-radius:18px;padding:16px 16px 12px;border:1px solid rgba(201,162,75,.25);position:relative;overflow:hidden;}
.prayer-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:11px;}
.prayer-title{font-family:'Noto Serif',serif;font-size:15px;font-weight:600;color:var(--gold-soft);}
select#citySelect{background:rgba(244,239,224,.08);color:var(--cream);border:1px solid rgba(244,239,224,.2);border-radius:9px;font-size:12px;padding:5px 9px;font-family:'Inter',sans-serif;}
.prayer-grid{display:flex;justify-content:space-between;gap:5px;}
.prayer-item{flex:1;text-align:center;padding:7px 2px;border-radius:11px;}
.prayer-item.active{background:rgba(201,162,75,.18);}
.prayer-name{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;}
.prayer-time{font-size:14px;font-weight:700;margin-top:3px;font-variant-numeric:tabular-nums;}
.prayer-status{font-size:11px;color:var(--muted);margin-top:9px;text-align:center;}
</style>
</head>
<body>
<div class="app">
  <header class="top">
    <div class="eyebrow">Дуоҳои Ҳаррӯза</div>
    <h1 class="brand">الأدعية اليومية</h1>
    <div class="brand-sub">Дуоҳои мухталиф аз Қуръон ва Суннати Набавӣ</div>
  </header>

  <div class="prayer-card">
    <div class="prayer-top">
      <div class="prayer-title">Вақти намоз</div>
      <select id="citySelect">
        <option value="Dushanbe">Душанбе</option>
        <option value="Khujand">Хуҷанд</option>
        <option value="Bokhtar">Бохтар</option>
        <option value="Kulob">Кӯлоб</option>
        <option value="Khorog">Хоруғ</option>
      </select>
    </div>
    <div class="prayer-grid" id="prayerGrid">
      <div class="prayer-item"><div class="prayer-name">Бомдод</div><div class="prayer-time">--:--</div></div>
      <div class="prayer-item"><div class="prayer-name">Пешин</div><div class="prayer-time">--:--</div></div>
      <div class="prayer-item"><div class="prayer-name">Аср</div><div class="prayer-time">--:--</div></div>
      <div class="prayer-item"><div class="prayer-name">Шом</div><div class="prayer-time">--:--</div></div>
      <div class="prayer-item"><div class="prayer-name">Хуфтан</div><div class="prayer-time">--:--</div></div>
    </div>
    <div class="prayer-status" id="prayerStatus">Дар ҳоли боргирӣ...</div>
  </div>

  <div class="section-label">Бобҳо</div>
  <div class="cards" id="homeView"></div>

  <div class="detail" id="detailView">
    <div class="detail-head">
      <button class="back-btn" onclick="closeDetail()">←</button>
      <div>
        <div class="detail-title" id="detailTitle">—</div>
        <div class="detail-sub" id="detailSub">—</div>
      </div>
    </div>
    <div id="detailBody"></div>
  </div>
</div>

