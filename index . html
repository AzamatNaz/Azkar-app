function renderHome(){
  const wrap = document.getElementById('homeView');
  wrap.innerHTML = '';
  CHAPTERS.forEach((ch,idx)=>{
    const c = document.createElement('div');
    c.className='cat-card';
    c.innerHTML = `<div class="cat-icon">${ch.icon}</div><div><div class="cat-num">БОБИ ${idx+1}</div><div class="cat-name">${ch.name}</div></div><div class="cat-arrow">›</div>`;
    c.onclick = ()=> openChapter(ch.id);
    wrap.appendChild(c);
  });
}
